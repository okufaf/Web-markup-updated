PORT=5173
JWT_SECRET=dev-only-secret-change-me

# Без DATABASE_URL аккаунты хранятся в data/users.json
# DATABASE_URL=postgres://av:av@localhost:5432/agriculture_vision

# Локальный ML-бэкенд (Docker: http://backend:8000)
ML_BACKEND_URL=http://localhost:8000

# Учётные данные dzz.by не хранятся в .env и не отдаются в браузер.
# Пользователь вводит их в настройках; сервер держит сессию и сам подставляет
# Basic Auth при запросах к https://www.dzz.by через /api/dzz.
# После npm start сессия поднимается из data/dzz-sessions.enc (AES-256-GCM, ключ JWT_SECRET).
