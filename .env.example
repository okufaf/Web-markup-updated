PORT=5173
# ВАЖНО: значение ниже — только для локальной разработки.
# В production (NODE_ENV=production) сервер откажется стартовать, если JWT_SECRET
# не задан или равен этому значению. Сгенерируйте свой: openssl rand -hex 32
JWT_SECRET=dev-only-secret-change-me

# Без DATABASE_URL аккаунты хранятся в data/users.json
# DATABASE_URL=postgres://av:av@localhost:5432/agriculture_vision

# Локальный ML-бэкенд (Docker: http://backend:8000)
ML_BACKEND_URL=http://localhost:8000

# Почта для восстановления пароля (код на email, кнопка "Забыли пароль?").
# Если SMTP_HOST не задан — письмо не отправляется, код выводится в консоль сервера
# (удобно для локальной разработки, не годится для production).
# SMTP_HOST=smtp.yandex.ru
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=no-reply@example.by
# SMTP_PASS=пароль-или-токен-приложения
# MAIL_FROM=Agriculture Vision <no-reply@example.by>

# Учётные данные dzz.by не хранятся в .env и не отдаются в браузер.
# Пользователь вводит их в настройках; сервер держит сессию и сам подставляет
# Basic Auth при запросах к https://www.dzz.by через /api/dzz.
# После npm start сессия поднимается из data/dzz-sessions.enc (AES-256-GCM, ключ JWT_SECRET).
# Ключ шифрования этого файла выводится из JWT_SECRET — при смене JWT_SECRET
# ранее сохранённые сессии dzz.by перестанут расшифровываться и потребуют повторного входа.
